# Copy outside Git or to .env.server (ignored by Git), then chmod 600.
# Absolute path owned by this stack; contains SQLite, logs, backups and uploads.
XIAN_YU_STATE_DIR=/srv/xianyu-manager
XIAN_YU_WEB_PORT=18080

# Required for a new database. Existing database passwords do not change here.
# Use a strong, non-default password. Never commit this value.
ADMIN_PASSWORD=

# Optional: set to an image already present in a private registry or local cache.
# XIAN_YU_CADDY_IMAGE=public.ecr.aws/docker/library/caddy:2.9-alpine
